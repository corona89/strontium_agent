# 개발 환경 (SQLite)
DATABASE_URL=sqlite+aiosqlite:///../db/app.db

# 운영 환경 (MySQL / MariaDB)
# DATABASE_URL=mysql+aiomysql://user:password@host:3306/dbname

JWT_SECRET=your-secret-key-here  # secrets.token_hex(32) 로 생성
COOKIE_SECURE=False  # 운영 환경에서는 True

# 프론트엔드 URL (OAuth 콜백 후 리다이렉트)
FRONTEND_URL=http://localhost:3000

# Google OAuth (미설정 시 OAuth 엔드포인트가 503 대신 로그인 페이지로 에러 리다이렉트)
# GOOGLE_CLIENT_ID=your-google-client-id
# GOOGLE_CLIENT_SECRET=your-google-client-secret
# GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# LLM 제공자 API 키 암호화 마스터 키 (Fernet). UI에서 등록된 키는 이 키로 암호화되어 DB에 저장된다.
# 생성: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# 미설정 시 개발은 임시 키 생성(재시작 시 기존 키 복호화 불가), 운영(COOKIE_SECURE=True)은 시작 거부.
# LLM_KEY_ENCRYPTION_KEY=...
# ABCLab 기본 base URL — 코드가 /v1/... 경로를 붙이므로 /v1 제외. 기본값: https://api.abclab.ktds.com
# ABCLAB_BASE_URL=https://api.abclab.ktds.com
