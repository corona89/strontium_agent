# 개발 환경 (SQLite)
DATABASE_URL=sqlite+aiosqlite:///../db/app.db

# 운영 환경 (MySQL / MariaDB)
# DATABASE_URL=mysql+aiomysql://user:password@host:3306/dbname

JWT_SECRET=your-secret-key-here  # secrets.token_hex(32) 로 생성
COOKIE_SECURE=False  # 운영 환경에서는 True

# 프론트엔드 URL (OAuth 콜백 후 리다이렉트)
FRONTEND_URL=http://localhost:3000

# Google OAuth (미설정 시 OAuth 엔드포인트가 503 대신 로그인 페이지로 에러 리다이렉트)
# GOOGLE_CLIENT_ID=your-google-client-id
# GOOGLE_CLIENT_SECRET=your-google-client-secret
# GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
